+    ),
+    "syncstatus": ("STARTED", "IN_PROGRESS", "COMPLETED", "FAILED", "CANCELLED"),
+}
+
+
+def _enum(dialect_name: str, name: str):
+    values = ENUM_TYPES[name]
+    if dialect_name == "postgresql":
