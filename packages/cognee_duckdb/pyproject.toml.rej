 [project]
 name = "cognee"
 version = "1.6.5"
-description = "Cognee fork for DuckDB backend"
-dependencies = []
+description = "Cognee 1.6.5 source for DuckDB integration"
+requires-python = ">=3.12,<3.14"
+license = "Apache-2.0"
+license-files = ["LICENSE", "NOTICE"]
+# Base requirements from the hash-verified Cognee 1.6.5 sdist, pinned to the
+# declared project prefix. DuckDB is the required replacement for
+# aiosqlite/diskcache and the bundled
+# Ladybug/Lance database engines. Their remaining source paths are unaccepted
+# integration work; omitting dependencies does not prove their removal.
+dependencies = [
