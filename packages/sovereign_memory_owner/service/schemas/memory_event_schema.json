{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory_event_schema.json",
  "title": "memory_event",
  "description": "Version 2 universal event envelope with four durable tier receipts, plus exact legacy 1.0.0 input compatibility. The semantic validator must bind each receipt event_id to the envelope, enforce idempotency and refuse fabricated legacy completions. SA_28-SA_30.",
  "oneOf": [
    {
      "$ref": "#/definitions/legacy_v1"
    },
    {
      "$ref": "#/definitions/envelope_v2"
    }
  ],
  "definitions": {
    "legacy_v1": {
      "title": "legacy_memory_event_v1",
      "description": "Accepted 1.0.0 single-tier input retained for compatibility only; ingestion must not invent four successful receipts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "tier",
        "content",
        "content_type",
        "ttl_seconds",
        "entity_refs",
        "agent_id",
        "source_artifact_id",
        "confidence",
        "source",
        "timestamp"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic version of this memory_event schema.",
          "const": "1.0.0"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for this memory event (UUID)."
        },
        "tier": {
          "type": "string",
          "enum": [
            "episodic",
            "temporal",
            "relational",
            "personalization"
          ],
          "description": "Which memory tier this record belongs in; selects the routing target."
        },
        "content": {
          "type": "string",
          "description": "The actual memory content."
        },
        "content_type": {
          "type": "string",
          "enum": [
            "fact",
            "observation",
            "correction",
            "inference",
            "preference"
          ],
          "description": "The kind of content this record carries."
        },
        "ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Time-to-live in seconds; null means permanent."
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entity identifiers this memory is about."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "description": "The agent that produced this memory."
        },
        "source_artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The artifact this memory was derived from, or null."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How confident the producing agent is in this memory."
        },
        "source": {
          "type": "string",
          "enum": [
            "observation",
            "inference",
            "human_correction",
            "llm_output"
          ],
          "description": "How this memory was produced."
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "description": "ISO 8601 timestamp of when this memory was created."
        }
      }
    },
    "envelope_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "actor_agent_id",
        "event_type",
        "created_at",
        "source_artifact_id",
        "work_id",
        "parent_event_id",
        "causation_event_id",
        "source_revision",
        "recipe_version",
        "model_occupant_id",
        "program_version",
        "payload_ref",
        "payload_sha256",
        "outcome",
        "exactness",
        "tier_receipts"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^2\\.[0-9]+\\.[0-9]+$"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "causation_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "recipe_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_occupant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "program_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "exactness": {
          "enum": [
            "observed",
            "derived",
            "inferred"
          ]
        },
        "tier_receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "episodic",
            "temporal",
            "relational",
            "personalization"
          ],
          "properties": {
            "episodic": {
              "$ref": "#/definitions/receipt"
            },
            "temporal": {
              "$ref": "#/definitions/receipt"
            },
            "relational": {
              "$ref": "#/definitions/receipt"
            },
            "personalization": {
              "$ref": "#/definitions/receipt"
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "processor_id",
        "processor_version",
        "projection_version",
        "status",
        "attempt_id",
        "attempted_at",
        "completed_at",
        "error_ref"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "processor_id": {
          "type": "string",
          "minLength": 1
        },
        "processor_version": {
          "type": "string",
          "minLength": 1
        },
        "projection_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "processing",
            "processed",
            "processed_no_new_fact",
            "retryable_failure",
            "terminal_failure",
            "unknown"
          ]
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}